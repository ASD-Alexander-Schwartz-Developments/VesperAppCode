<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VesperApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:m="using:VesperApp.Models"
		xmlns:ui="using:FluentAvalonia.UI.Controls"
		xmlns:Controls="using:VesperApp.Controls"
		xmlns:conv="using:Avalonia.Data.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
		MinWidth="860"
		MinHeight="480"
        x:Class="VesperApp.Views.MainView">

	<Design.DataContext>
		<vm:MainViewViewModel/>
	</Design.DataContext>

	<Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

		<!-- ═══════════════════════ Header ═══════════════════════ -->
		<Border Grid.Row="0" Classes="card" Padding="14,10">
			<Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

				<!-- Brand -->
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
					<Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AppAccentSoftBrush}">
						<Image Source="/Assets/bat.png" Width="22" Height="22"
							   VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</Border>
					<StackPanel VerticalAlignment="Center" Spacing="0">
						<TextBlock Text="Vesper" FontSize="17" FontWeight="SemiBold"/>
						<TextBlock Text="Device Console" Classes="caption"/>
					</StackPanel>
				</StackPanel>

				<!-- Dock connection + controls -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
							HorizontalAlignment="Center" VerticalAlignment="Center">

					<Border Classes="statusPill success" IsVisible="{Binding IsConnected}">
						<StackPanel Orientation="Horizontal" Spacing="7">
							<Ellipse Classes="statusDot" Fill="{DynamicResource SuccessBrush}"/>
							<TextBlock Text="Dock connected" VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
					<Border Classes="statusPill danger" IsVisible="{Binding !IsConnected}">
						<StackPanel Orientation="Horizontal" Spacing="7">
							<Ellipse Classes="statusDot" Fill="{DynamicResource DangerBrush}"/>
							<TextBlock Text="No dock" VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<Button Classes="toolbar" Command="{Binding ConnectDisconnectDockCommand}" x:Name="ConnectToggle">
						<StackPanel Orientation="Horizontal" Spacing="7">
							<Image Source="/Assets/connected.png" IsVisible="{Binding IsConnected}" Width="18" Height="18" VerticalAlignment="Center"/>
							<Image Source="/Assets/disconnected.png" IsVisible="{Binding !IsConnected}" Width="18" Height="18" VerticalAlignment="Center"/>
							<TextBlock VerticalAlignment="Center" Text="Connect Dock" IsVisible="{Binding !IsConnected}"/>
							<TextBlock VerticalAlignment="Center" Text="Disconnect Dock" IsVisible="{Binding IsConnected}"/>
						</StackPanel>
					</Button>

					<Border Width="1" Background="{DynamicResource AppStrokeBrush}" Margin="4,3" IsVisible="{Binding IsConnected}"/>

					<StackPanel x:Name="spDockControls" Orientation="Horizontal" Spacing="6"
								IsEnabled="{Binding IsConnected}" IsVisible="{Binding IsConnected}">
						<Button Classes="toolbar" Command="{Binding EnableDeviceDockCommand}" x:Name="DockEnableDeviceToggle">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<Ellipse Classes="statusDot" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding !IsDeviceEnabled}"/>
								<Ellipse Classes="statusDot" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDeviceEnabled}"/>
								<TextBlock VerticalAlignment="Center" Text="Enable Device" IsVisible="{Binding !IsDeviceEnabled}"/>
								<TextBlock VerticalAlignment="Center" Text="Disable Device" IsVisible="{Binding IsDeviceEnabled}"/>
							</StackPanel>
						</Button>
						<Button Classes="toolbar" Command="{Binding ResetDeviceDockCommand}" x:Name="DockRestDeviceButton" Content="Reset Device"/>
						<Button Classes="toolbar" Command="{Binding Boot0ModeDockCommand}" x:Name="DockBoot0DeviceToggle">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<Ellipse Classes="statusDot" Fill="{DynamicResource WarningBrush}" IsVisible="{Binding IsDeviceBoot0Mode}"/>
								<TextBlock VerticalAlignment="Center" Text="Device Boot" IsVisible="{Binding !IsDeviceBoot0Mode}"/>
								<TextBlock VerticalAlignment="Center" Text="Exit Boot" IsVisible="{Binding IsDeviceBoot0Mode}"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</StackPanel>

				<!-- Devices console toggle + clock -->
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

					<!-- Compact detection summary while the console is collapsed -->
					<Border Classes="statusPill" VerticalAlignment="Center"
							IsVisible="{Binding !IsDeviceConsoleExpanded}">
						<TextBlock VerticalAlignment="Center">
							<Run Text="{Binding LoggerDevices.Count}"/><Run Text=" devices"/>
						</TextBlock>
					</Border>

					<Button Classes="toolbar" Command="{Binding ToggleDeviceConsoleCommand}"
							ToolTip.Tip="Show or hide the device console — collapse it to give the working area the full height">
						<StackPanel Orientation="Horizontal" Spacing="7">
							<ui:SymbolIcon Symbol="ChevronUp" FontSize="16" VerticalAlignment="Center"
										   IsVisible="{Binding IsDeviceConsoleExpanded}"/>
							<ui:SymbolIcon Symbol="ChevronDown" FontSize="16" VerticalAlignment="Center"
										   IsVisible="{Binding !IsDeviceConsoleExpanded}"/>
							<TextBlock VerticalAlignment="Center" Text="Devices"/>
						</StackPanel>
					</Button>

					<!-- Logger clock: the time Set Time writes, and which time (UTC or this PC's local) -->
					<Border Classes="statusPill" VerticalAlignment="Center" Padding="14,3,4,3"
							ToolTip.Tip="Logger clock: the time Set Time puts on loggers. UTC is recommended (GNSS positions need UTC); Local uses this PC's time zone. The logger keeps the choice with its clock and marks its data with it, so it decodes correctly on any PC. Saved.">
						<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
							<StackPanel VerticalAlignment="Center">
								<TextBlock Classes="caption" FontSize="11" Text="Logger clock"/>
								<TextBlock x:Name="textDateTime" Classes="mono" FontSize="14" Text="{Binding TextDateTimeNow}"/>
							</StackPanel>
							<ComboBox x:Name="comboLoggerClock" VerticalAlignment="Center" MinWidth="0"
									  SelectedIndex="{Binding LoggerClockIndex}">
								<ComboBoxItem Content="UTC"/>
								<ComboBoxItem Content="{Binding LoggerClockLocalText}"/>
							</ComboBox>
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ═══════════════════════ Devices ═══════════════════════ -->
		<!-- Collapsible: hidden, the working area (Grid.Row=2, height "*") absorbs this row's
		     space — offline work (editor, Help, decoding) gets the full window height. -->
		<Border Grid.Row="1" Classes="card" Padding="0"
				IsVisible="{Binding IsDeviceConsoleExpanded}">
			<DockPanel LastChildFill="True">

				<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,12,14,8">
					<TextBlock Text="Logger Devices" Classes="sectionHeader" VerticalAlignment="Center"/>
					<Border Grid.Column="1" Classes="statusPill" VerticalAlignment="Center">
						<TextBlock VerticalAlignment="Center">
							<Run Text="{Binding LoggerDevices.Count}"/><Run Text=" detected"/>
						</TextBlock>
					</Border>
				</Grid>

				<!-- Device actions -->
				<Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource AppStrokeBrush}"
						BorderThickness="0,1,0,0" Padding="12,8">
				  <StackPanel Spacing="4">
					<WrapPanel Orientation="Horizontal">
						<Button Classes="toolbar" Margin="0,2,6,2" Command="{Binding ConnectDisconnectDeviceCommand}" x:Name="DeviceConnectButton">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<Image Source="/Assets/connected.png" IsVisible="{Binding IsDeviceConnected}" Width="18" Height="18" VerticalAlignment="Center"/>
								<Image Source="/Assets/disconnected.png" IsVisible="{Binding !IsDeviceConnected}" Width="18" Height="18" VerticalAlignment="Center"/>
								<TextBlock VerticalAlignment="Center" Text="Connect Device" IsVisible="{Binding !IsDeviceConnected}"/>
								<TextBlock VerticalAlignment="Center" Text="Disconnect Device" IsVisible="{Binding IsDeviceConnected}"/>
							</StackPanel>
						</Button>
						<Border Width="1" Background="{DynamicResource AppStrokeBrush}" Margin="4,4"/>
						<!-- Hidden for a KOL with the operating states: it sleeps by itself when unplugged and records through Start Recording. -->
						<Button Classes="toolbar" Margin="0,2,6,2" Content="Sleep" Command="{Binding SleepDeviceCommand}" IsEnabled="{Binding IsDeviceIdle}" IsVisible="{Binding ShowSleepCommands}"/>
						<Button Classes="toolbar" Margin="0,2,6,2" Content="Arm Sleep" Command="{Binding ArmSleepDeviceCommand}" IsEnabled="{Binding IsDeviceIdle}" IsVisible="{Binding ShowSleepCommands}"/>
						<Button Classes="toolbar" Margin="0,2,6,2" Content="Format" Command="{Binding FormatDeviceCommand}" IsEnabled="{Binding CanUseDeviceDisk}"
								ToolTip.Tip="Format the device's storage (unavailable while a KOL is in Live Audio - no disk is exposed in that mode)"/>
						<Button Classes="toolbar" Margin="0,2,6,2" Content="Set Time" Command="{Binding SetDateTimeDeviceCommand}" IsEnabled="{Binding IsDeviceIdle}"/>
						<Button Classes="toolbar" Margin="0,2,6,2" Content="Upload Config" Command="{Binding UploadDeviceConfig}" IsEnabled="{Binding CanUseDeviceDisk}"
								ToolTip.Tip="Send a configuration file to the device: over USB to a Nanotag, as config.json on the drive of a Vesper, Pipistrelle or KOL"/>
						<Button Classes="toolbar" Margin="0,2,6,2" Content="Download Data" Command="{Binding DownloadDeviceData}" IsEnabled="{Binding CanUseDeviceDisk}"
								ToolTip.Tip="Get all recorded data: every page of a Nanotag, or the recorded files from the drive of a Vesper, Pipistrelle or KOL (guided import)"/>
						<Button Classes="toolbar" Margin="0,2,0,2" Content="Upgrade Firmware" Command="{Binding BootloaderDeviceCommand}" IsEnabled="{Binding IsDeviceIdle}"/>
						<Button Classes="toolbar" Margin="6,2,0,2" Content="Nanotag Console" Command="{Binding OpenNanotagConsoleCommand}"
								IsVisible="{Binding IsNanotagSelected}"
								ToolTip.Tip="Disk health, the configuration on the tag and its serial console"/>

						<!-- USB operational modes (KOL; Vesper / Pipistrelle firmware 1.22+). Idle = disk + console;
						     Live Audio = USB microphone (4 channels on KOL, 1 on Vesper), no disk; Sampling = off USB, running its schedule. -->
						<Border Width="1" Background="{DynamicResource AppStrokeBrush}" Margin="4,4" IsVisible="{Binding IsUsbModesSelected}"/>
						<Border Classes="statusPill" Margin="0,2,6,2" IsVisible="{Binding IsUsbModesSelected}"
								ToolTip.Tip="{Binding UsbModeToolTip}">
							<TextBlock VerticalAlignment="Center">
								<Run Text="USB mode: "/><Run Text="{Binding KolUsbModeText}"/>
							</TextBlock>
						</Border>
						<Button Classes="toolbar" Margin="0,2,6,2" Content="{Binding KolLiveAudioButtonText}"
								Command="{Binding KolToggleLiveAudioCommand}" IsVisible="{Binding IsUsbModesSelected}" IsEnabled="{Binding IsDeviceConnected}"
								ToolTip.Tip="Switch between Idle and Live Audio. The device re-enumerates (about 2 s) and is reconnected automatically."/>
						<Button Classes="toolbar" Margin="0,2,6,2" Content="{Binding StartRecordingButtonText}"
								Command="{Binding KolStartSamplingCommand}" IsVisible="{Binding IsUsbModesSelected}" IsEnabled="{Binding IsDeviceConnected}"
								ToolTip.Tip="{Binding StartRecordingToolTip}"/>

						<!-- KOL with the operating states: can it record (card, config.json, sensor, clock, space)? -->
						<Border Classes="statusPill" Margin="0,2,6,2" IsVisible="{Binding IsKolStatesSelected}"
								ToolTip.Tip="{Binding KolReadinessToolTip}">
							<TextBlock VerticalAlignment="Center" Text="{Binding KolReadinessText}"/>
						</Border>
						<Button Classes="toolbar" Margin="0,2,0,2" Content="Check"
								Command="{Binding KolCheckCommand}" IsVisible="{Binding IsKolStatesSelected}" IsEnabled="{Binding IsDeviceConnected}"
								ToolTip.Tip="Have the KOL read config.json from its card again and report whether it can record (after copying a new config.json onto its USB disk)."/>
					</WrapPanel>
					<TextBlock Classes="caption" Text="{Binding KolStatusText}" TextWrapping="Wrap" IsVisible="{Binding HasKolStatus}"/>
				  </StackPanel>
				</Border>

				<!-- Device list -->
				<ListBox x:Name="listLoggerDevices"
						 ItemsSource="{Binding LoggerDevices}"
						 SelectionMode="Single"
						 Selection="{Binding SelectedLoggerDeviceModel}"
						 Background="Transparent"
						 BorderThickness="0"
						 MinHeight="120" MaxHeight="260"
						 Margin="6,0,6,4">
					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Padding" Value="10,4"/>
						</Style>
					</ListBox.Styles>
					<ListBox.Template>
						<ControlTemplate>
							<DockPanel LastChildFill="True">
								<Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}"
										BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1"
										CornerRadius="6,6,0,0" Padding="10,8">
									<Grid ColumnDefinitions="1.2*,*,*,0.6*,0.6*,175,135,1.2*,70" ColumnSpacing="12">
										<TextBlock Grid.Column="0" Classes="colHeader" Text="Serial number"/>
										<TextBlock Grid.Column="1" Classes="colHeader" Text="Type"/>
										<TextBlock Grid.Column="2" Classes="colHeader" Text="Nickname"/>
										<TextBlock Grid.Column="3" Classes="colHeader" Text="Hardware"/>
										<TextBlock Grid.Column="4" Classes="colHeader" Text="Firmware"/>
										<TextBlock Grid.Column="5" Classes="colHeader" Text="Device time"
												   ToolTip.Tip="The logger's own clock, as it reads now"/>
										<TextBlock Grid.Column="6" Classes="colHeader" Text="Clock"
												   ToolTip.Tip="Which time the logger's clock keeps: UTC or local time (Nanotag 1.39+ reports it)"/>
										<TextBlock Grid.Column="7" Classes="colHeader" Text="Storage"/>
										<TextBlock Grid.Column="8" Classes="colHeader" Text="Battery"/>
									</Grid>
								</Border>
								<Panel>
									<ScrollViewer x:Name="PART_ScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
										<ItemsPresenter/>
									</ScrollViewer>
									<TextBlock Classes="subtle" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
											   TextAlignment="Center" TextWrapping="Wrap"
											   IsVisible="{Binding !LoggerDevices.Count}"
											   Text="No loggers connected. Plug a logger into USB, or connect its dock, and it appears here."/>
								</Panel>
							</DockPanel>
						</ControlTemplate>
					</ListBox.Template>
					<ListBox.ItemTemplate>
						<DataTemplate DataType="m:LoggerDevice">
							<Grid ColumnDefinitions="1.2*,*,*,0.6*,0.6*,175,135,1.2*,70" ColumnSpacing="12" VerticalAlignment="Center" MinHeight="28">
								<TextBlock Grid.Column="0" Classes="mono" Text="{Binding SerialNumber}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
								<TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
								<TextBlock Grid.Column="2" Text="{Binding Nickname}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
								<TextBlock Grid.Column="3" Text="{Binding HwId}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
								<TextBlock Grid.Column="4" Text="{Binding FwId}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
								<TextBlock Grid.Column="5" Classes="mono" Text="{Binding LocalDateTime}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
								<Border Grid.Column="6" Classes="statusPill" HorizontalAlignment="Left" Padding="8,1"
										IsVisible="{Binding ClockBaseText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
										ToolTip.Tip="{Binding ClockBaseToolTip}">
									<TextBlock Text="{Binding ClockBaseText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
								</Border>
								<TextBlock Grid.Column="7" Text="{Binding DiskStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
										   ToolTip.Tip="{Binding DiskStatus}"/>
								<TextBlock Grid.Column="8" Text="{Binding BatteryChargePercent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Border>

		<!-- ═══════════════════════ Navigation / pages ═══════════════════════ -->
		<Border Grid.Row="2" Classes="surface" Padding="0" ClipToBounds="True">
			<ui:NavigationView x:Name="TabbedNavigationView"
							   PaneDisplayMode="LeftCompact"
							   IsSettingsVisible="False"
							   MenuItemsSource="{Binding Categories}"
							   Content="{Binding CurrentPage}"
							   SelectedItem="{Binding SelectedCategory}">
				<ui:NavigationView.MenuItemTemplateSelector>
					<m:MenuItemTemplateSelector>
						<DataTemplate DataType="{x:Type m:Category}">
							<ui:NavigationViewItem Content="{Binding Name}" IconSource="{Binding Icon}" ToolTip.Tip="{Binding ToolTip}" IsVisible="{Binding IsVisible}" />
						</DataTemplate>
						<m:MenuItemTemplateSelector.SeparatorTemplate>
							<DataTemplate DataType="{x:Type m:Separator}">
								<ui:NavigationViewItemSeparator />
							</DataTemplate>
						</m:MenuItemTemplateSelector.SeparatorTemplate>
					</m:MenuItemTemplateSelector>
				</ui:NavigationView.MenuItemTemplateSelector>
			</ui:NavigationView>
		</Border>

		<!-- ═══════════════════════ Status bar ═══════════════════════ -->
		<Border Grid.Row="3" Classes="statusBar">
			<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<Ellipse Classes="statusDot" Fill="{DynamicResource InfoBrush}"/>
				<TextBlock x:Name="textLogWindow" Classes="subtle" VerticalAlignment="Center"
						   TextTrimming="CharacterEllipsis" Text="{Binding TextMessageBottom}"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
